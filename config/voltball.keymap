#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
        };

        combo2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <6 7>;
        };

        combo3 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
        };

        combo4 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        combo5 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <22 23>;
        };

        combo6 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <28 29>;
        };

        combo7 {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <4 5>;
        };

        combo8 {
            bindings = <&kp PIPE>;
            key-positions = <14 15>;
        };

        combo9 {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
        };

        combo10 {
            bindings = <&mo 5>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                                               &kp Y         &kp U  &kp I     &kp O          &kp P
&kp A             &kp S         &kp D         &kp F        &kp G                                                               &kp H         &kp J  &kp K     &kp L          &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B              &mt LS(LG(S)) COMMA      &kp PERIOD              &kp N         &kp M  &mkp MB1  &mkp MB2       &kp SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_WIN  &lt 2 SPACE  &lt (3) LS(SPACE)  &kp TAB                  &mt LEFT_ALT RIGHT_GUI  &ltq 1 ENTER                   &kp RIGHT_GUI  &kp BACKSPACE
            >;

            display-name = "BASE";
        };

        FUNCTION {
            bindings = <
&none   &none   &none   &none       &none                                &none            &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &kp LC(F5)  &kp F12                              &none            &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans  &trans      &trans   &trans      &kp UNDERSCORE  &trans           &kp F1  &kp F2  &kp F3  &kp F12
&trans  &trans  &trans  &trans      &trans   &trans      &trans          &kp RIGHT_SHIFT                  &trans  &kp DELETE
            >;

            display-name = "FUNCTION";
        };

        CHARA {
            bindings = <
&kp ESC  &trans  &kp TILDE  &kp LEFT_BRACE    &kp RIGHT_BRACE                        &kp PLUS       &kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp INTERNATIONAL_3
&none    &trans  &kp CARET  &kp LESS_THAN     &kp GREATER_THAN                       &kp COLON      &kp DOLLAR       &kp PERCENT           &kp AMPERSAND          &kp EQUAL
&none    &trans  &kp PIPE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp AT      &trans  &kp SEMICOLON  &kp EXCLAMATION  &kp DOUBLE_QUOTES     &kp HASH               &kp QUESTION
&trans   &trans  &trans     &trans            &trans             &trans      &trans  &none                                                 &trans                 &kp DELETE
            >;

            display-name = "CHARA";
        };

        WORK {
            bindings = <
&kp ESC  &none   &kp LS(F10)  &trans    &trans                               &kp PLUS   &kp N7  &kp N8  &kp N9  &kp N0
&trans   &trans  &trans       &trans    &none                                &kp COLON  &kp N4  &kp N5  &kp N6  &kp MINUS
&trans   &trans  &trans       &kp LBKT  &kp RBKT  &trans      &kp BACKSLASH  &kp SEMI   &kp N1  &kp N2  &kp N3  &kp FSLH
&trans   &trans  &trans       &trans    &trans    &trans      &trans         &trans                     &trans  &kp BSPC
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                         &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans                         &trans  &none   &none   &none   &trans
&trans  &trans    &trans    &trans    &trans     &trans      &trans  &trans  &none   &trans  &none   &trans
&trans  &trans    &trans    &trans    &kp LCTRL  &trans      &trans  &trans                  &trans  &trans
            >;

            display-name = "MOUSE";
        };

        SCROLL {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                                               &trans         &trans    &trans    &trans          &mt LC(HOME) HOME
&trans      &trans  &trans  &trans  &trans                                               &trans         &mkp MB5  &kp LEFT  &kp UP_ARROW    &kp RIGHT
&trans      &trans  &trans  &none   &kp LG(LEFT)  &kp LG(RIGHT)      &kp LS(LEFT_ARROW)  &kp LS(RIGHT)  &mkp MB4  &trans    &kp DOWN_ARROW  &mt LC(END) END
&trans      &trans  &trans  &trans  &trans        &trans             &trans              &kp LA(F4)                         &trans          &trans
            >;
        };
    };
};
