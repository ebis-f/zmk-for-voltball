#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        BT1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 7>;
        };

        BT2 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <15 17>;
        };

        BT3 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <6 8>;
        };

        BT4 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <16 18>;
        };

        BT_CL_A {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <27 31>;
        };

        BT_CL {
            bindings = <&bt BT_CLR>;
            key-positions = <5 9>;
        };

        PIN {
            bindings = <&PIN>;
            key-positions = <0 10>;
        };

        PW {
            bindings = <&PW>;
            key-positions = <32 20>;
        };

        MIDDLE_CLICK {
            bindings = <&mkp MB3>;
            key-positions = <29 30>;
        };
    };

    behaviors {
        lt_sspc: lt_sspc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SSPC";
            bindings = <&mo>, <&S_SPC>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    macros {
        IME_TG: IME_TG {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE)>;
            label = "IME_TG";
        };

        S_SPC: S_SPC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SPACE)>;
            label = "S_SPC";
        };

        PIN: PIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N8 &kp N0 &kp N9 &kp NUMBER_2 &kp N7>;
            label = "PIN";
        };

        HANKAKU: IME {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F10 &kp ENTER>;
            label = "IME";
        };

        PW: PW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N7 &kp LBKT &kp LS(G) &kp LS(S) &kp LS(S) &kp LS(G) &kp LS(S) &kp LS(S) &kp N2 &kp N0 &kp N1 &kp N9>;
            label = "PW";
        };

        LOCAL_ACCOUNT: LOCAL_ACCOUNT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp O &kp B &kp E &kp BSLH &kp B &kp Y &kp P &kp A &kp S &kp S &kp N &kp R &kp O &kp DOT &kp C &kp M &kp D &kp ENTER>;
            label = "LOCAL_ACCOUNT";
        };

        ADMIN: ADMIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp D &kp M &kp I &kp N &kp ENTER>;
            label = "ADMIN";
        };

        MAP_RM: MAP_RM {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(R) &kp LS(M)>;
            label = "MAP_RM";
        };

        MAP_F: MAP_F {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F)>;
            label = "MAP_F";
        };

        MAP_ENCODE: MAP_ENCODE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(F12))>;
            label = "MAP_ENCODE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                                               &kp Y         &kp U  &kp I     &kp O       &kp P
&kp A             &kp S         &kp D         &kp F        &kp G                                                               &kp H         &kp J  &kp K     &kp L       &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B              &mt LS(LG(S)) COMMA      &kp PERIOD              &kp N         &kp M  &mkp MB1  &mkp MB2    &kp SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_WIN  &lt 2 SPACE  &lt_sspc 3 0  &kp TAB                  &mt LEFT_ALT RIGHT_GUI  &ltq 1 ENTER                   &kp DELETE  &kp BACKSPACE
            >;

            display-name = "BASE";
        };

        FUNCTION {
            bindings = <
&none   &none   &none   &none       &none                                &none            &kp F7  &kp F8  &kp F9      &kp F10
&trans  &trans  &trans  &kp LC(F5)  &kp F12                              &none            &kp F4  &kp F5  &kp F6      &kp F11
&trans  &trans  &trans  &trans      &trans   &trans      &kp UNDERSCORE  &trans           &kp F1  &kp F2  &kp F3      &kp F12
&trans  &trans  &trans  &trans      &trans   &trans      &trans          &kp RIGHT_SHIFT                  &kp DELETE  &kp BACKSPACE
            >;

            display-name = "FUNCTION";
        };

        CHARA {
            bindings = <
&kp ESC  &trans  &kp TILDE  &kp LEFT_BRACE    &kp RIGHT_BRACE                        &kp PLUS       &kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp INTERNATIONAL_3
&none    &trans  &kp CARET  &kp LESS_THAN     &kp GREATER_THAN                       &kp COLON      &kp DOLLAR       &kp PERCENT           &kp AMPERSAND          &kp EQUAL
&none    &trans  &kp PIPE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp AT      &trans  &kp SEMICOLON  &kp EXCLAMATION  &kp DOUBLE_QUOTES     &kp HASH               &kp QUESTION
&trans   &trans  &trans     &trans            &trans             &trans      &trans  &none                                                 &kp DELETE             &kp BACKSPACE
            >;

            display-name = "CHARA";
        };

        WORK {
            bindings = <
&kp ESC    &kp LS(F10)  &LOCAL_ACCOUNT  &ADMIN     &trans                                &kp PLUS   &kp N7  &kp N8  &kp N9      &kp N0
&trans     &MAP_ENCODE  &MAP_RM         &MAP_F     &none                                 &kp COLON  &kp N4  &kp N5  &kp N6      &kp MINUS
&kp LC(Z)  &kp LC(X)    &kp LC(C)       &kp LC(V)  &kp LC(B)  &trans      &kp BACKSLASH  &kp SEMI   &kp N1  &kp N2  &kp N3      &kp FSLH
&trans     &trans       &trans          &trans     &trans     &trans      &trans         &trans                     &kp DELETE  &kp BSPC
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                         &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans                         &trans  &none   &none   &none   &trans
&trans  &trans    &trans    &trans    &trans     &trans      &trans  &trans  &none   &trans  &none   &trans
&trans  &trans    &trans    &trans    &kp LCTRL  &trans      &trans  &trans                  &trans  &trans
            >;

            display-name = "MOUSE";
        };

        SCROLL {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                                               &trans         &trans    &trans    &trans          &mt LC(HOME) HOME
&trans      &trans  &trans  &trans  &trans                                               &trans         &mkp MB5  &kp LEFT  &kp UP_ARROW    &kp RIGHT
&trans      &trans  &trans  &none   &kp LG(LEFT)  &kp LG(RIGHT)      &kp LS(LEFT_ARROW)  &kp LS(RIGHT)  &mkp MB4  &trans    &kp DOWN_ARROW  &mt LC(END) END
&trans      &trans  &trans  &trans  &trans        &trans             &trans              &kp LA(F4)                         &trans          &trans
            >;
        };
    };
};
